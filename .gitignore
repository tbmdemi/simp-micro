# --- Generated pipeline outputs (large, regenerable via scripts) ---
# NOTE: outputs/multi_batch/, outputs/figures/, outputs/pipeline/ are already
# tracked in git history intentionally - do NOT blanket-ignore outputs/.
# Only the Phase 3 dataset-build outputs are ignored here (regenerate via
# pipeline/phase3/*.py).
outputs/phase3/*.npz
outputs/phase3/manifest.csv

# phase3_v2: dataset regeneration thử nghiệm (xem analysis/scripts/generate_production_batch.py)
outputs/phase3_v2/*.npz
outputs/phase3_v2/manifest.csv
outputs/phase3_v2/split_report.json

# raw pool scratch (ảnh + manifest thô trước khi lọc) - KHÔNG dùng /tmp (tmpfs,
# mất dữ liệu qua reboot - đã xảy ra thật, mất ~3.5h compute, xem EXPERIMENT_LOG.md)
outputs/phase3_v2_raw/

# backup outputs/phase3/*.npz gốc trước khi thay bằng phase3_v2 (có thể khôi phục)
outputs/phase3_backup/

# pilot use_sqrt/move_min/penal_init (2026-07-26, xem EXPERIMENT_LOG.md) - scratch, không phải dataset
outputs/pilot_damping_decay/

# pilot OC hai-multiplier (stiffness_mode='dual', branch OC-2-multilayer) - scratch, không phải dataset
outputs/pilot_oc_dual_multiplier/
outputs/_smoke_*/

# pilot MMA (nlopt.LD_MMA, simp/mma_runner.py) - scratch, không phải dataset
outputs/pilot_mma/
outputs/pilot_mma_*/

